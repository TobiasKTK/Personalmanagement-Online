{
  "name": "pemonline-frontend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "vorbereiten": "node scripts/abhaengigkeiten.cjs",
    "test:installation": "node --test scripts/abhaengigkeiten.test.cjs",
    "test:build": "node --test scripts/bauen.test.cjs",
    "start": "node node_modules/@angular/cli/bin/ng.js serve --host 127.0.0.1 --port 4200",
    "build": "node scripts/bauen.cjs",
    "test": "node node_modules/@playwright/test/cli.js test",
    "test:email": "node node_modules/@playwright/test/cli.js test --config=playwright.email.config.ts"
  },
  "engines": {
    "node": "^24.15.0"
  },
  "dependencies": {
    "@angular/common": "22.2.2",
    "@angular/compiler": "22.2.2",
    "@angular/core": "22.2.2",
    "@angular/forms": "22.2.2",
    "@angular/platform-browser": "22.2.2",
    "@angular/router": "22.2.2",
    "rxjs": "7.8.2",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@angular/build": "22.2.2",
    "@angular/cli": "22.2.2",
    "@angular/compiler-cli": "22.2.2",
    "@playwright/test": "1.64.0",
    "typescript": "~6.0.0"
  },
  "allowScripts": {
    "@parcel/watcher@2.6.0": true,
    "esbuild@0.28.2": true
  }
}
